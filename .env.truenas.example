# Salin menjadi .env di folder yang sama dengan docker-compose.truenas.yml. JANGAN commit .env.

# Alamat publik (harus sama dengan hostname di Cloudflare Tunnel)
APP_URL=https://vecs.kukode.in

# Lokasi data persisten di TrueNAS (dataset), mis. /mnt/tank/apps/vecs
DATA_PATH=/mnt/tank/apps/vecs

# Rahasia — buat tiga nilai BERBEDA:  openssl rand -base64 48
# SIMPAN. Mengganti ENCRYPTION_KEY membuat data terenkripsi (nomor telepon, token QR) tidak terbaca lagi.
SESSION_SECRET=
TOKEN_HASH_SECRET=
ENCRYPTION_KEY=

# Cloudflare Tunnel: Zero Trust → Networks → Tunnels → buat tunnel → salin token
TUNNEL_TOKEN=

# Cloudflare Realtime TURN: Dashboard → Realtime → TURN → buat TURN key
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Email (SMTP) — untuk verifikasi email & reset kata sandi. Tanpa ini, pendaftar baru tidak menerima email.
# Port 587 = STARTTLS (SMTP_SECURE=false); port 465 = TLS langsung (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Vehicle Contact <no-reply@kukode.in>

# Opsional (kosong = mode simulasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Image (ubah ke tag tertentu untuk mengunci versi, mis. :1.0.3)
# VECS_IMAGE=ghcr.io/mistersupri/vehicle-contact-system:latest
