# Salin ke .env. JANGAN commit .env. Di production semua *_SECRET/KEY wajib diisi.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173        # domain publik (dipakai di URL QR & tautan email)
TRUST_PROXY=0                        # set 1 di belakang Nginx agar IP klien benar (rate limit)

# Rahasia (buat dengan: openssl rand -base64 48)
SESSION_SECRET=
TOKEN_HASH_SECRET=
ENCRYPTION_KEY=

# WebRTC. TURN wajib untuk jaringan seluler/firewall ketat.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=                     # mis. turn:turn.contoh.com:3478?transport=udp,turns:turn.contoh.com:5349
WEBRTC_TURN_SECRET=                  # sama dengan static-auth-secret di coturn

# Cloudflare Realtime TURN (disarankan bila tanpa IP publik; mengalahkan coturn bila diisi)
# Dashboard Cloudflare → Realtime → TURN → buat TURN key. Token = rahasia, hanya di server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Telegram (opsional; tanpa ini = mode simulasi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (opsional; tanpa ini = mode simulasi)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# PSTN: none | mock. Provider nyata belum dipilih (lihat docs/DECISIONS.md)
TELEPHONY_PROVIDER=none
TELEPHONY_WEBHOOK_SECRET=
